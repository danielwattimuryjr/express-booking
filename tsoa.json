{
    "entryFile": "src/app.ts",
    "noImplicitAdditionalProperties": "throw-on-extras",
    "controllerPathGlobs": [
        "src/**/*Controller.ts"
    ],
    "spec": {
        "outputDirectory": "docs",
        "specVersion": 3,
        "basePath": "/api/v1",
        "securityDefinitions": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "routes": {
        "routesDir": "src",
        "basePath": "/api/v1",
        "authenticationModule": "./src/config/auth.ts",
        "routesFileName": "generated-routes.ts"
    }
}
